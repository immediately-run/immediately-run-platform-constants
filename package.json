{
  "name": "@immediately-run/platform-constants",
  "version": "0.8.1",
  "description": "The single source of truth for cross-repo platform vocabulary (the .immediately.run cache-zip sidecar layout + the content contract: APP_ROOT, the metadata key space, the frontmatter envelope, the mdx-metadata sidecar schema; the shared telemetry + security-events registries). Consumed by cli, sandbox, and site-main so a rename/extension touches ONE package, not N repos in lockstep (R3-104).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/immediately-run-platform-constants.git"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "lint": "eslint src test",
    "check:dependency-free": "node scripts/check-dependency-free.mjs --self-test && node scripts/check-dependency-free.mjs",
    "prepare": "npm run build",
    "check:pins": "node scripts/check-dependency-pins.mjs --self-test && node scripts/check-dependency-pins.mjs",
    "check:publish-version": "node scripts/check-publish-version.mjs --self-test && node scripts/check-publish-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
